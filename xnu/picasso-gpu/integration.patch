+void
+AppleCLCD::queuePresent(const uint8_t *rec, uint64_t sequence)
+{
+	IOLockLock(fLock);
+	if (fWorkReady) ++fSuperseded;
+	memcpy(fWorkRec, rec, SWEET_FB_SWAP_REC_SIZE);
+	fWorkSequence = sequence;
+	fWorkReady = true;
+	thread_wakeup(&fWorkReady);
+	IOLockUnlock(fLock);
+}
+
+void
+AppleCLCD::presentThread(void *arg, wait_result_t)
+{
+	AppleCLCD *fb = (AppleCLCD *)arg;
+	uint8_t rec[SWEET_FB_SWAP_REC_SIZE];
+	for (;;) {
+		IOLockLock(fb->fLock);
+		while (!fb->fWorkReady) {
+			assert_wait(&fb->fWorkReady, THREAD_UNINT);
+			IOLockUnlock(fb->fLock);
+			thread_block(THREAD_CONTINUE_NULL);
+			IOLockLock(fb->fLock);
+		}
+		memcpy(rec, fb->fWorkRec, sizeof(rec));
+		uint64_t sequence = fb->fWorkSequence;
+		fb->fWorkReady = false;
+		bool off = fb->fPowerOff;
+		IOLockUnlock(fb->fLock);
+		uint64_t began = mach_absolute_time(), ns;
+		bool ok = !off && fb->present(rec);
+		absolutetime_to_nanoseconds(mach_absolute_time() - began, &ns);
+		IOLockLock(fb->fLock);
+		if (ok) { ++fb->fPresented; fb->fCopyNS += ns; }
+		else { ++fb->fDeferred; if (!off && fb->fSubmitted == sequence) fb->fDirty = true; }
+		if (fb->fStats && fb->fPresented && fb->fPresented % 120 == 0)
+			IOLog("PICASSO FB: submitted=%llu presented=%llu deferred=%llu superseded=%llu avg-copy-us=%llu\n",
+			    fb->fSubmitted, fb->fPresented, fb->fDeferred, fb->fSuperseded,
+			    fb->fCopyNS / fb->fPresented / 1000);
+		IOLockUnlock(fb->fLock);
+	}
 }
 
