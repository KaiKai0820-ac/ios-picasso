+/* Novatek nt36672c event layout, Linux sm7250 at 8e49d06a. */
+#ifndef PICASSO_NVT_PROTOCOL_H
+#define PICASSO_NVT_PROTOCOL_H
+#define NV_CONTACTS 10u
+#define NV_PACKET_BYTES 65u
+#define NV_PANEL_X 1080u
+#define NV_PANEL_Y 2400u
+struct nv_frame {
+	uint16_t mask;
+	uint16_t x[NV_CONTACTS], y[NV_CONTACTS];
+};
+enum { NV_FRAME_VALID, NV_FRAME_IGNORE, NV_FRAME_INVALID };
+static int
+nv_decode_packet(const uint8_t *packet, unsigned length, struct nv_frame *frame)
+{
+	if (!packet || !frame || length != NV_PACKET_BYTES) {
+		return NV_FRAME_INVALID;
+	}
+	/* Firmware recovery/watchdog patterns are not contact packets. */
+	/* FF contact slots are ordinary empty slots and must release fingers. */
+	if (packet[0] == 0x77 || packet[0] == 0xfd || packet[0] == 0xfe) {
+		bool same = true;
+		for (unsigned i = 1; i < 6; ++i) {
+			same = same && packet[i] == packet[0];
+		}
+		if (same) {
+			return NV_FRAME_IGNORE;
+		}
+	}
+	frame->mask = 0;
+	for (unsigned i = 0; i < NV_CONTACTS; ++i) {
+		const uint8_t *contact = packet + 6u * i;
+		unsigned id = contact[0] >> 3, status = contact[0] & 7u;
+		if (status != 1 && status != 2) {
+			continue;
+		}
+		if (id == 0 || id > NV_CONTACTS) {
+			return NV_FRAME_INVALID;
+		}
+		unsigned slot = id - 1u;
+		unsigned x = ((unsigned)contact[1] << 4) | (contact[3] >> 4);
+		unsigned y = ((unsigned)contact[2] << 4) | (contact[3] & 15u);
+		if (x >= NV_PANEL_X || y >= NV_PANEL_Y || (frame->mask & (1u << slot))) {
+			return NV_FRAME_INVALID;
+		}
+		frame->mask |= (uint16_t)(1u << slot);
+		frame->x[slot] = (uint16_t)x;
+		frame->y[slot] = (uint16_t)y;
+	}
+	return NV_FRAME_VALID;
+}
+#endif
