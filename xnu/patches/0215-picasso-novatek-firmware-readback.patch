--- a/bsd/dev/picasso_nvt.c
+++ b/bsd/dev/picasso_nvt.c
@@ -451,6 +451,38 @@
 	return ETIMEDOUT;
 }
 
+/* Compare every downloaded byte while the MCU is still in its bootloader.
+ * Keep reads <=32 wire bytes; do not depend on multiword register snapshots. */
+static int
+nv_verify_firmware(void)
+{
+	uint8_t bytes[30];
+	for (unsigned i = 0; i < sizeof(nv_fw_parts) / sizeof(nv_fw_parts[0]); ++i) {
+		const struct nv_fw_partition *part = &nv_fw_parts[i];
+		uint32_t done = 0, length = part->size + 1u;
+		while (done < length) {
+			uint32_t address = part->sram + done;
+			unsigned count = MIN(length - done, MIN(sizeof(bytes), 128u - (address & 0x7fu)));
+			int error = nv_register(address, bytes, count);
+			if (error) {
+				printf("PICASSO NVT: RAM readback partition%u offset=%#x err=%d\n", i, done, error);
+				return error;
+			}
+			for (unsigned j = 0; j < count; ++j) {
+				uint8_t expected = nv_firmware[part->image + done + j];
+				if (bytes[j] != expected) {
+					printf("PICASSO NVT: RAM mismatch partition%u address=%#x got=%02x expected=%02x\n",
+					    i, address + j, bytes[j], expected);
+					return EIO;
+				}
+			}
+			done += count;
+		}
+		printf("PICASSO NVT: RAM partition%u readback verified bytes=%u\n", i, length);
+	}
+	return 0;
+}
+
 static int
 nv_download_firmware(void)
 {
@@ -480,6 +512,9 @@
 			image += count;
 			remaining -= count;
 		}
+	}
+	if ((error = nv_verify_firmware())) {
+		return error;
 	}
 	/* Length is the vendor's final-byte index, not the number transferred. */
 	const uint32_t destinations[] = {0x3f128, 0x3f12c};
@@ -504,7 +539,11 @@
 	nv_sleep(5);
 	error = nv_wait_reset(0xa0);
 	uint8_t result[8] = {0}, flags = 0;
-	int crc_error = nv_read_memory(0x3f120u, result, sizeof(result));
+	/* Vendor nvt_read_bld_hw_crc reads each 32-bit result separately. */
+	int crc_error = nv_register(0x3f120u, result, 4);
+	if (!crc_error) {
+		crc_error = nv_register(0x3f124u, result + 4, 4);
+	}
 	if (!crc_error) {
 		crc_error = nv_register(0x3f133u, &flags, 1);
 	}
@@ -514,9 +553,18 @@
 	if (error || crc_error) {
 		return error ? error : crc_error;
 	}
+	if (!(flags & 4u) || (flags & 3u)) {
+		return EIO;
+	}
+	/* In local31i the MCU reaches INIT with CRC_DONE/no errors, yet our
+	 * extra post-boot DLM snapshot comparison rejects it. Vendor success
+	 * uses reset readiness (and reads raw CRC values only on failure).
+	 * Exact RAM readback above proves what we transferred before boot;
+	 * keep status, REK readiness and fw-info checks as mandatory gates.
+	 * Do not assume the raw result snapshot is a stable success contract. */
 	if (nv_le32(result) != nv_fw_parts[0].crc ||
-	    nv_le32(result + 4) != nv_fw_parts[1].crc || !(flags & 4u) || (flags & 3u)) {
-		return EIO;
+	    nv_le32(result + 4) != nv_fw_parts[1].crc) {
+		printf("PICASSO NVT: post-boot CRC snapshot differs; RAM verified, checking firmware readiness\n");
 	}
 	return nv_wait_reset(0xa1);
 }
